    "name": "Student Placement Tracker REST API",
    "description": "Comprehensive Postman test collection for Student Placement Tracker RESTful API built with Node.js and Express. Demonstrates all CRUD endpoints, query filtering, pagination, sorting, dynamic parameters, and centralized error handling responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Students Collection",
      "item": [
        {
          "name": "1. GET All Students (Default Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Retrieves the first page of student placement records with default limit of 10."
          },
          "response": []
        },
        {
          "name": "2. GET Students (Pagination: Page 2, Limit 4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?page=2&limit=4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "limit", "value": "4" }
              ]
            },
            "description": "Fetches page 2 with 4 records per page, demonstrating pagination metadata."
          },
          "response": []
        },
        {
          "name": "3. GET Students - Filter by Department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?department=Computer Science",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "department", "value": "Computer Science" }
              ]
            },
            "description": "Filters student records specifically for Computer Science department."
          },
          "response": []
        },
        {
          "name": "4. GET Students - Filter by Status & Min CGPA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?status=Placed&minCgpa=8.5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "status", "value": "Placed" },
                { "key": "minCgpa", "value": "8.5" }
              ]
            },
            "description": "Compound filter: students who are Placed and have CGPA >= 8.5."
          },
          "response": []
        },
        {
          "name": "5. GET Students - Search by Keyword",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?search=React",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "search", "value": "React" }
              ]
            },
            "description": "Full-text search matching name, roll number, or technical skills."
          },
          "response": []
        },
        {
          "name": "6. GET Students - Sort by Package (Descending)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?status=Placed&sortBy=packageOffered&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "status", "value": "Placed" },
                { "key": "sortBy", "value": "packageOffered" },
                { "key": "order", "value": "desc" }
              ]
            },
            "description": "Sorts placed students from highest salary package to lowest."
          },
          "response": []
        },
        {
          "name": "7. GET Single Student by Dynamic ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/1",
